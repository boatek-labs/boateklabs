# Copy this file to .env and fill in real values before deploying.

PORT=3000
NODE_ENV=production

# Restrict CORS to your real domain in production, e.g. https://boateklabs.com
ALLOWED_ORIGIN=

# SMTP settings for contact form / newsletter / chat notification emails.
# If left blank, the server logs submissions to the console instead of emailing —
# the site still works fully, you just won't get email notifications until this is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=hello@boateklabs.com

# Bootstrap owner account for the admin dashboard (http://localhost:3000/admin).
# Only used the very first time the server starts (when data/admins.json is
# empty) — after that, manage accounts from the dashboard's Team Accounts panel.
# CHANGE ADMIN_PASSWORD before deploying — 'changeme' is only a safe default for local dev.
ADMIN_EMAIL=admin@boateklabs.com
ADMIN_PASSWORD=changeme

# Optional: force a specific public URL for links sent in emails (e.g. a custom
# domain). If left blank, the app detects this automatically from the actual
# incoming request host/protocol — correct for local dev, Render, Railway, Fly,
# or any other host, with no per-platform configuration needed.
SITE_URL=

# Paystack donations (secret key stays server-side)
PAYSTACK_SECRET_KEY=

# Newsletter AI drafting (OpenRouter compatible)
OPENROUTER_API_KEY=
NEWSLETTER_AI_MODEL=openai/gpt-4o-mini

# Secret used to hash email verification OTPs (set a long random value in production)
OTP_SECRET=
